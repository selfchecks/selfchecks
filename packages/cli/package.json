{
  "name": "@selfchecks/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "selfchecks": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -b tsconfig.json --pretty false"
  },
  "dependencies": {
    "@selfchecks/core": "workspace:*",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "tsx": "^4.20.3"
  }
}
