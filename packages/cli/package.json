{
  "name": "@selfchecks/cli",
  "version": "0.0.0",
  "private": true,
  "license": "Elastic-2.0",
  "type": "module",
  "bin": {
    "selfchecks": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./runner": {
      "import": "./dist/runner.js",
      "types": "./dist/runner.d.ts"
    },
    "./ai-analysis": {
      "import": "./dist/ai-analysis.js",
      "types": "./dist/ai-analysis.d.ts"
    },
    "./environment": {
      "import": "./dist/environment.js",
      "types": "./dist/environment.d.ts"
    },
    "./storage": {
      "import": "./dist/storage.js",
      "types": "./dist/storage.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=../../.env --import tsx src/index.ts",
    "typecheck": "tsc -b tsconfig.json --pretty false"
  },
  "dependencies": {
    "@selfchecks/core": "workspace:*",
    "@selfchecks/db": "workspace:*",
    "@selfchecks/selfchecks": "workspace:*",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
