generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CheckType {
  API
  BROWSER
}

enum CheckRunStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  TIMED_OUT
  CANCELLED
}

enum CheckRunSource {
  SCHEDULE
  MANUAL
  CLI
}

enum ArtifactType {
  LOG
  SCREENSHOT
  TRACE
  VIDEO
  REQUEST_RESPONSE
  JSON
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum WebhookAdapter {
  GENERIC
  ROCKET_CHAT
}

enum WebhookEndpointSource {
  MANIFEST
  MANUAL
}

enum TestSessionKind {
  TEST
  TRIGGER
}

model Project {
  id                  String               @id @default(cuid())
  slug                String               @unique
  name                String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  checks              Check[]
  deployments         Deployment[]
  groups              CheckGroup[]
  aiSettings          AiSettings?
  performanceSettings PerformanceSettings?
  runtimeEnvironments RuntimeEnvironment[]
  secrets             Secret[]
  webhookEndpoints    WebhookEndpoint[]
  notifications       Notification[]
  testSessions        TestSession[]
  runs                CheckRun[]
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  tokenHash  String    @unique
  prefix     String
  lastFour   String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([revokedAt, createdAt])
}

model Deployment {
  id         String   @id @default(cuid())
  projectId  String
  gitSha     String?
  source     String?
  deployedBy String?
  summary    Json?
  createdAt  DateTime @default(now())
  checks     Check[]
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model CheckGroup {
  id               String                      @id @default(cuid())
  projectId        String
  key              String
  name             String
  tags             String[]
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  checks           Check[]
  webhookEndpoints CheckGroupWebhookEndpoint[]
  project          Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
}

model Check {
  id                   String      @id @default(cuid())
  projectId            String
  groupId              String?
  deploymentId         String?
  key                  String
  name                 String
  type                 CheckType
  enabled              Boolean     @default(true)
  frequencyMinutes     Int?
  degradedResponseTime Int?
  tags                 String[]
  entrypoint           String?
  request              Json?
  retryStrategy        Json?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deployment           Deployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull)
  group                CheckGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  project              Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs                 CheckRun[]

  @@unique([projectId, key])
  @@index([projectId, type])
}

model TestSession {
  id          String          @id @default(cuid())
  projectId   String
  kind        TestSessionKind @default(TRIGGER)
  name        String?
  source      String?
  repository  String?
  ref         String?
  commitSha   String?
  pipelineUrl String?
  jobUrl      String?
  targetUrl   String?
  status      CheckRunStatus  @default(QUEUED)
  createdAt   DateTime        @default(now())
  runs        CheckRun[]
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, kind, createdAt])
}

model CheckRun {
  id                                String          @id @default(cuid())
  projectId                         String
  checkId                           String?
  testSessionId                     String?
  status                            CheckRunStatus  @default(QUEUED)
  runSource                         CheckRunSource?
  attempt                           Int             @default(1)
  maxAttempts                       Int             @default(1)
  retryGroupId                      String?
  startedAt                         DateTime?
  timeoutAt                         DateTime?
  finishedAt                        DateTime?
  durationMs                        Int?
  errorMessage                      String?
  logsPath                          String?
  result                            Json?
  checkSnapshotKey                  String?
  checkSnapshotName                 String?
  checkSnapshotType                 CheckType?
  checkSnapshotTags                 String[]        @default([])
  checkSnapshotEntrypoint           String?
  checkSnapshotRequest              Json?
  checkSnapshotDegradedResponseTime Int?
  checkSnapshotGroupName            String?
  checkSnapshotProjectSlug          String?
  createdAt                         DateTime        @default(now())
  artifacts                         Artifact[]
  notifications                     Notification[]
  check                             Check?          @relation(fields: [checkId], references: [id], onDelete: Cascade)
  testSession                       TestSession?    @relation(fields: [testSessionId], references: [id], onDelete: SetNull)
  project                           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status, createdAt])
  @@index([checkId, createdAt])
  @@index([checkSnapshotProjectSlug])
  @@index([testSessionId, status, createdAt])
  @@index([retryGroupId, attempt])
  @@index([status, createdAt])
  @@index([status, timeoutAt])
}

model Artifact {
  id        String       @id @default(cuid())
  runId     String
  type      ArtifactType
  path      String
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime     @default(now())
  run       CheckRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model WebhookEndpoint {
  id            String                      @id @default(cuid())
  projectId     String
  logicalId     String
  name          String
  adapter       WebhookAdapter              @default(GENERIC)
  source        WebhookEndpointSource       @default(MANUAL)
  method        String                      @default("POST")
  urlCiphertext String
  template      String?
  sendFailure   Boolean                     @default(true)
  sendRecovery  Boolean                     @default(true)
  sendDegraded  Boolean                     @default(false)
  sslExpiry     Boolean                     @default(false)
  enabled       Boolean                     @default(true)
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  project       Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checkGroups   CheckGroupWebhookEndpoint[]
  notifications Notification[]

  @@unique([projectId, logicalId])
  @@index([projectId, enabled])
}

model CheckGroupWebhookEndpoint {
  checkGroupId      String
  webhookEndpointId String
  createdAt         DateTime        @default(now())
  checkGroup        CheckGroup      @relation(fields: [checkGroupId], references: [id], onDelete: Cascade)
  webhookEndpoint   WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)

  @@id([checkGroupId, webhookEndpointId])
  @@index([webhookEndpointId])
}

model Notification {
  id                String             @id @default(cuid())
  projectId         String?
  webhookEndpointId String?
  runId             String?
  webhookName       String?
  event             String
  status            NotificationStatus @default(PENDING)
  payload           Json
  responseStatus    Int?
  error             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  project           Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run               CheckRun?          @relation(fields: [runId], references: [id], onDelete: Cascade)
  webhookEndpoint   WebhookEndpoint?   @relation(fields: [webhookEndpointId], references: [id], onDelete: SetNull)

  @@unique([webhookEndpointId, runId, event])
  @@index([projectId, status, createdAt])
  @@index([runId])
}

model AiSettings {
  id               String   @id @default(cuid())
  projectId        String   @unique
  apiEndpoint      String
  apiKeyCiphertext String?
  model            String
  responseLanguage String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PerformanceSettings {
  id                                String   @id @default(cuid())
  projectId                         String   @unique
  workerConcurrency                 Int      @default(2)
  failedArtifactRetentionDays       Int      @default(14)
  passedArtifactRetentionDays       Int      @default(14)
  historyRetentionDays              Int      @default(180)
  queuedRunTimeoutMinutes           Int      @default(30)
  runningRunTimeoutMinutes          Int      @default(120)
  testSessionTimeoutMinutes         Int      @default(30)
  testSessionWorkspaceRetentionDays Int      @default(14)
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt
  project                           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model RuntimeEnvironment {
  id        String   @id @default(cuid())
  projectId String
  name      String
  variables Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
}

model Secret {
  id              String   @id @default(cuid())
  projectId       String
  name            String
  valueCiphertext String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
}
