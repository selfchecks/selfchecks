    "@selfchecks/core": "workspace:*",
    "@selfchecks/db": "workspace:*",
    "bullmq": "^5.56.4",
    "ioredis": "^5.6.1"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
