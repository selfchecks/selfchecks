{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "incremental": true,
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["./*"],
      "@selfchecks/cli/ai-analysis": ["../../packages/cli/src/ai-analysis.ts"],
      "@selfchecks/cli/environment": ["../../packages/cli/src/environment.ts"],
      "@selfchecks/core": ["../../packages/core/src/index.ts"],
      "@selfchecks/core/performance-settings": [
        "../../packages/core/src/performance-settings.ts"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
